# Server
NODE_ENV=production
PORT=3000
BASE_URL=https://your-deployed-url.example.com
SESSION_SECRET=change-this-to-a-long-random-string

# Database — Supabase (or any Postgres) connection string.
# In Supabase: Project Settings -> Database -> Connection string -> "URI" (use the
# "Transaction pooler" / port 6543 version for serverless-style hosts like Render/Railway).
DATABASE_URL=postgresql://postgres:your-password@your-project.pooler.supabase.com:6543/postgres

# First-run HR admin account (only used to seed the hr_users table if it's empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# SMTP — used only for the "Send rejection email" button in the candidate
# detail view. Candidate invite links are still generated manually by HR
# (not emailed automatically). Leave these unset and that button will show
# a clear error instead of silently failing.
# Gmail: use an App Password, not your normal password (https://myaccount.google.com/apppasswords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password-or-app-password
SMTP_FROM=you@example.com
